<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for bubble overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service for accessibility monitoring awareness indicator -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Network for Firestore sync (ranking cache) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CoachApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Main entry — consent disclosure flow -->
        <activity
            android:name=".ui.ConsentDisclosureActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings / in-app revoke toggle -->
        <activity
            android:name=".ui.CoachSettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- AccessibilityService — the core monitoring component -->
        <service
            android:name=".monitor.AccessibilityMonitor"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Overlay service for bubble rendering -->
        <service
            android:name=".ui.BubbleOverlayService"
            android:exported="false" />

    </application>
</manifest>
